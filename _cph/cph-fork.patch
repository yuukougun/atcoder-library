@@ -0,0 +1,72 @@
+/** [fork] 「提出用にコピー」ボタンの処理 */
+import * as vscode from 'vscode';
+import fs from 'fs';
+import path from 'path';
+import { bundleSource, expandPathVars } from './bundler';
+import { getBundleIncludePaths, getBundleImplMarker } from './preferences';
+
+const BUNDLE_EXTS = new Set(['.cpp', '.cc', '.cxx', '.hpp', '.h', '.c']);
+
+export const copyBundled = async (srcPath: string) => {
+    // 開いているエディタの内容(未保存の変更を含む)を優先して使う
+    const openDoc = vscode.workspace.textDocuments.find(
+        (d) => path.resolve(d.fileName) === path.resolve(srcPath),
+    );
+    let text: string;
+    if (openDoc) {
+        text = openDoc.getText();
+    } else if (fs.existsSync(srcPath)) {
+        text = fs.readFileSync(srcPath, 'utf8');
+    } else {
+        vscode.window.showErrorMessage(`ファイルが見つかりません: ${srcPath}`);
+        return;
+    }
+
+    const ext = path.extname(srcPath).toLowerCase();
+    if (!BUNDLE_EXTS.has(ext)) {
+        await vscode.env.clipboard.writeText(text);
+        vscode.window.showInformationMessage(
+            `${path.basename(srcPath)} をコピーしました`,
+        );
+        return;
+    }
+
+    const workspaceFolder =
+        vscode.workspace.getWorkspaceFolder(vscode.Uri.file(srcPath))?.uri
+            .fsPath ??
+        vscode.workspace.workspaceFolders?.[0]?.uri.fsPath ??
+        path.dirname(srcPath);
+    const includePaths = getBundleIncludePaths().map((p) =>
+        expandPathVars(p, workspaceFolder),
+    );
+
+    try {
+        const result = bundleSource(
+            srcPath,
+            text,
+            includePaths,
+            getBundleImplMarker(),
+        );
+        await vscode.env.clipboard.writeText(result.code);
+
+        let msg = `${path.basename(srcPath)} をコピーしました`;
+        if (result.expandedFiles.length > 0) {
+            msg += `(ライブラリ ${result.expandedFiles.length} 個を展開)`;
+        }
+        vscode.window.showInformationMessage(msg);
+
+        if (result.unresolved.length > 0) {
+            vscode.window.showWarningMessage(
+                `見つからない #include があります(そのまま残しました): ${result.unresolved.join(
+                    ', ',
+                )}`,
+            );
+        }
+        for (const w of result.warnings) {
+            vscode.window.showWarningMessage(w);
+        }
+    } catch (err: any) {
+        globalThis.logger.error('Bundle failed', err);
+        vscode.window.showErrorMessage(`展開に失敗しました: ${err.message}`);
+    }
+};
