+    );
+    write(
+        path.join(lib, 'uf.hpp'),
+        '#pragma once\n#include <vector>\nstruct UF { std::vector<int> p; UF(int n):p(n,-1){} int find(int x){return p[x]<0?x:p[x]=find(p[x]);} };\n',
+    );
+    write(
+        path.join(lib, 'debug.hpp'),
+        '#pragma once\n#include <iostream>\n#define dump(x) std::cerr << #x << "=" << (x) << "\\n"\nvoid dbg_helper();\n// @impl\nvoid dbg_helper() {}\n',
+    );
+});
+
+afterEach(() => fs.rmSync(tmp, { recursive: true, force: true }));
+
+describe('fork bundler', () => {
+    test('expands nested includes once, moves @impl after main', () => {
+        const root = path.join(ws, 'a.cpp');
+        const text =
+            '#include <bits/stdc++.h>\n#include "lcm.hpp"\n#include "gcd.hpp"\n#include "uf.hpp"\nusing namespace std;\nint main(){ UF u(3); cout << mylcm(4,6) << " " << mygcd(12,18) << " " << u.find(1) << endl; }\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.unresolved).toEqual([]);
+        expect(r.expandedFiles.length).toBe(3);
+        expect(r.code).not.toMatch(/#include "/);
+        expect(r.code).not.toMatch(/pragma once|LCM_HPP/);
+        // 宣言は main より前、本体は main より後ろ
+        const mainPos = r.code.indexOf('int main');
+        expect(
+            r.code.indexOf('long long mygcd(long long a, long long b);'),
+        ).toBeLessThan(mainPos);
+        expect(r.code.indexOf('return b ? mygcd')).toBeGreaterThan(mainPos);
+        // gcd は1回だけ
+        expect(r.code.match(/begin: gcd\.hpp/g)?.length).toBe(1);
+        if (hasGpp) expect(compileRun(r.code)).toBe('12 6 1');
+    });
+
+    test('include inside #ifdef LOCAL is not split and stays inside the block', () => {
+        const root = path.join(ws, 'b.cpp');
+        const text =
+            '#include <bits/stdc++.h>\n#ifdef LOCAL\n#include "debug.hpp"\n#else\n#define dump(x)\n#endif\nint main(){ int a = 3; dump(a); std::cout << a << std::endl; }\n';
+        write(root, text);
+        const r = bundle(root, text);
+        const endifPos = r.code.indexOf('#endif');
+        expect(r.code.indexOf('void dbg_helper() {}')).toBeLessThan(endifPos);
+        expect(r.code).not.toMatch(/impl: debug\.hpp/);
+        if (hasGpp) expect(compileRun(r.code)).toBe('3');
+    });
+
+    test('file included conditionally is expanded again when included unconditionally', () => {
+        const root = path.join(ws, 'c.cpp');
+        const text =
+            '#include <bits/stdc++.h>\n#ifdef LOCAL\n#include "gcd.hpp"\n#endif\n#include "gcd.hpp"\nint main(){ std::cout << mygcd(6, 4) << std::endl; }\n';
+        write(root, text);
+        const r = bundle(root, text);
+        if (hasGpp) expect(compileRun(r.code)).toBe('2');
+    });
+
+    test('circular includes do not loop', () => {
+        write(
+            path.join(lib, 'x.hpp'),
+            '#pragma once\n#include "y.hpp"\nint fx();\n',
+        );
+        write(
+            path.join(lib, 'y.hpp'),
+            '#pragma once\n#include "x.hpp"\nint fy();\n',
+        );
+        const root = path.join(ws, 'd.cpp');
+        const text = '#include "x.hpp"\nint main(){}\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.expandedFiles.length).toBe(2);
+    });
+
+    test('unresolved include is kept and reported', () => {
+        const root = path.join(ws, 'e.cpp');
+        const text =
+            '#include "nothere.hpp"\n#include "nothere.hpp"\nint main(){}\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.unresolved).toEqual(['nothere.hpp']);
+        expect(r.code).toMatch(/#include "nothere\.hpp"/);
+    });
+
+    test('marker inside #if block is ignored with a warning', () => {
+        write(
+            path.join(lib, 'bad.hpp'),
+            '#pragma once\n#if 1\nint f();\n// @impl\nint f(){return 1;}\n#endif\n',
+        );
+        const root = path.join(ws, 'f.cpp');
+        const text = '#include "bad.hpp"\nint main(){ return f() - 1; }\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.warnings.length).toBe(1);
+        expect(r.code).not.toMatch(/impl: bad\.hpp/);
+        if (hasGpp) compileRun(r.code);
+    });
+
+    test('marker match is exact (@implementation is not a marker)', () => {
+        write(
+            path.join(lib, 'm.hpp'),
+            '#pragma once\n// @implementation notes\nint g(){return 0;}\n',
+        );
+        const root = path.join(ws, 'g.cpp');
+        const text = '#include "m.hpp"\nint main(){ return g(); }\n';
+        write(root, text);
+        expect(bundle(root, text).code).not.toMatch(/impl: m\.hpp/);
+    });
+
+    test('relative include from the source directory', () => {
+        write(path.join(ws, 'mine', 'h.hpp'), 'int h(){return 0;}\n');
+        const root = path.join(ws, 'h.cpp');
+        const text = '#include "mine/h.hpp"\nint main(){ return h(); }\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.unresolved).toEqual([]);
+        expect(r.code).toMatch(/int h\(\)/);
+    });
+
+    test('CRLF files work', () => {
+        write(
+            path.join(lib, 'crlf.hpp'),
+            '#pragma once\r\nint k();\r\n// @impl\r\nint k(){return 0;}\r\n',
+        );
+        const root = path.join(ws, 'i.cpp');
+        const text = '#include "crlf.hpp"\r\nint main(){ return k(); }\r\n';
+        write(root, text);
+        const r = bundle(root, text);
+        expect(r.code).not.toMatch(/\r/);
+        expect(r.code.indexOf('int k(){return 0;}')).toBeGreaterThan(
+            r.code.indexOf('int main'),
+        );
+    });
+});
+
+describe('stripIncludeGuard', () => {
+    test('not a guard when #endif closes early', () => {
+        const lines = [
+            '#ifndef A',
+            '#define A',
+            '#endif',
+            'int x;',
+            '#ifdef B',
+            '#endif',
+        ];
+        expect(stripIncludeGuard(lines)).toEqual(lines);
+    });
+    test('strips a real guard', () => {
+        expect(
+            stripIncludeGuard([
+                '// c',
+                '#ifndef A',
+                '#define A',
+                'int x;',
+                '#endif // A',
+                '',
+            ]),
+        ).toEqual(['// c', 'int x;', '']);
+    });
+    test('#define with value is not a guard', () => {
+        const lines = ['#ifndef N', '#define N 100', '#endif'];
+        expect(stripIncludeGuard(lines)).toEqual(lines);
+    });
+});
diff --git a/src/tests/forkProblemPath.test.ts b/src/tests/forkProblemPath.test.ts
new file mode 100644
index 0000000..10bfa1e
--- /dev/null
+++ b/src/tests/forkProblemPath.test.ts
@@ -0,0 +1,66 @@
+import os from 'os';
+import path from 'path';
+import { getProblemPathVars, resolveProblemPath } from '../problemPath';
+
+const ws = '/home/u/atcoder';
+const vars = getProblemPathVars(
+    'https://atcoder.jp/contests/abc400/tasks/abc400_a?lang=ja',
+    'AtCoder - AtCoder Beginner Contest 400',
+    ws,
+);
+
+describe('fork problem path', () => {
+    test('vars from AtCoder URL', () => {
+        expect(vars.contest).toBe('abc400');
+        expect(vars.task).toBe('abc400_a');
+        expect(vars.index).toBe('a');
+    });
+    test('empty settings keep cph default', () => {
+        expect(resolveProblemPath('', '', vars)).toEqual({
+            dir: ws,
+            baseName: null,
+            unknown: [],
+        });
+    });
+    test('contest folder + index file', () => {
+        const r = resolveProblemPath(
+            '${workspaceFolder}/${contest}',
+            '${index}',
+            vars,
+        );
+        expect(r.dir).toBe('/home/u/atcoder/abc400');
+        expect(r.baseName).toBe('a');
+    });
+    test('relative and ~ paths', () => {
+        expect(resolveProblemPath('contests/${contest}', '', vars).dir).toBe(
+            '/home/u/atcoder/contests/abc400',
+        );
+        expect(resolveProblemPath('~/cp/${contest}', '', vars).dir).toBe(
+            path.join(os.homedir(), 'cp/abc400'),
+        );
+    });
+    test('non-AtCoder URL falls back to default name', () => {
+        const v = getProblemPathVars(
+            'https://codeforces.com/problemset/problem/1/A',
+            'Codeforces',
+            ws,
+        );
+        const r = resolveProblemPath(
+            '${workspaceFolder}/${contest}',
+            '${index}',
+            v,
+        );
+        expect(r.dir).toBe(ws);
+        expect(r.baseName).toBeNull();
+    });
+    test('unknown variables are reported', () => {
+        expect(
+            resolveProblemPath('${foo}', '${bar}_${index}', vars).unknown,
+        ).toEqual(['foo', 'bar']);
+    });
+    test('file name cannot escape directory', () => {
+        expect(resolveProblemPath('', '../${index}', vars).baseName).toBe(
+            '.._a',
+        );
+    });
+});
