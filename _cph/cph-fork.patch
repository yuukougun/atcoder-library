diff --git a/src/bundler.ts b/src/bundler.ts
new file mode 100644
index 0000000..4dbc52c
--- /dev/null
+++ b/src/bundler.ts
@@ -0,0 +1,214 @@
+/**
+ * [fork] 提出用バンドラー(vscode に依存しない純粋なモジュール)
+ *
+ * - `#include "..."` を再帰的に展開する(山括弧の <...> はそのまま残す)
+ * - 同じファイルは一度だけ展開する(#pragma once / インクルードガード相当)
+ *   展開したファイルの `#pragma once` とインクルードガードは取り除く
+ * - ライブラリ内に `// @impl` 行があれば、その行より上は include した位置に、
+ *   下は元ファイルの末尾(main の後ろ)にまとめて出力する
+ * - `#ifdef LOCAL` などの条件ブロックの中で include されたファイルは、
+ *   分割すると条件の外に出てしまうので、@impl を無視してその場に丸ごと展開する
+ */
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+
+export type BundleResult = {
+    code: string;
+    expandedFiles: string[];
+    unresolved: string[];
+    warnings: string[];
+};
+
+const INCLUDE_RE = /^\s*#\s*include\s*"([^"]+)"/;
+const PRAGMA_ONCE_RE = /^\s*#\s*pragma\s+once\b/;
+const IF_RE = /^\s*#\s*if(n?def)?\b/;
+const ENDIF_RE = /^\s*#\s*endif\b/;
+
+const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+/** `~` と `${workspaceFolder}` を展開し、相対パスは workspaceFolder 基準にする */
+export const expandPathVars = (p: string, workspaceFolder: string): string => {
+    let ret = p.trim().replace(/\$\{workspaceFolder\}/g, workspaceFolder);
+    if (ret === '~') {
+        ret = os.homedir();
+    } else if (ret.startsWith('~/')) {
+        ret = path.join(os.homedir(), ret.slice(2));
+    }
+    if (!path.isAbsolute(ret)) {
+        ret = path.join(workspaceFolder, ret);
+    }
+    return ret;
+};
+
+/**
+ * 先頭の `#ifndef X` + `#define X` と、それに対応する末尾の `#endif` を
+ * インクルードガードとみなして取り除く。ガードでなければそのまま返す。
+ */
+export const stripIncludeGuard = (lines: string[]): string[] => {
+    const isBlank = (l: string) => /^\s*(\/\/.*)?$/.test(l);
+    let i = 0;
+    while (i < lines.length && isBlank(lines[i])) i++;
+    const ifndef = lines[i]?.match(/^\s*#\s*ifndef\s+(\w+)\s*(\/\/.*)?$/);
+    if (!ifndef) return lines;
+    let j = i + 1;
+    while (j < lines.length && isBlank(lines[j])) j++;
+    const define = lines[j]?.match(/^\s*#\s*define\s+(\w+)\s*(\/\/.*)?$/);
+    if (!define || define[1] !== ifndef[1]) return lines;
+
+    // 末尾の #endif を探し、それが先頭の #ifndef と対応しているか確認する
+    let k = lines.length - 1;
+    while (k > j && /^\s*(\/\/.*|\/\*.*\*\/)?\s*$/.test(lines[k])) k--;
+    if (k <= j || !ENDIF_RE.test(lines[k])) return lines;
+    let depth = 0;
+    for (let x = j + 1; x < k; x++) {
+        if (IF_RE.test(lines[x])) depth++;
+        else if (ENDIF_RE.test(lines[x])) {
+            depth--;
+            if (depth < 0) return lines; // 途中でガードが閉じている
+        }
+    }
+    if (depth !== 0) return lines;
+    return [
+        ...lines.slice(0, i),
+        ...lines.slice(j + 1, k),
+        ...lines.slice(k + 1),
+    ];
+};
+
+export const bundleSource = (
+    rootPath: string,
+    rootText: string,
+    includePaths: string[],
+    implMarker: string,
+): BundleResult => {
+    const markerRe = new RegExp(
+        `^\\s*//\\s*${escapeRegExp(implMarker.trim() || '@impl')}(?![\\w-])`,
+    );
+    // 無条件に展開済みのファイル(以後の include は省略してよい)
+    const visited = new Set<string>();
+    const expandedFiles: string[] = [];
+    const unresolved: string[] = [];
+    const tails: string[] = [];
+    const warnings: string[] = [];
+    // 展開中のファイル(循環 include の検出用)
+    const stack = new Set<string>();
+
+    const resolve = (name: string, fromDir: string): string | null => {
+        const candidates = [fromDir, ...includePaths].map((dir) =>
+            path.resolve(dir, name),
+        );
+        for (const c of candidates) {
+            try {
+                if (fs.statSync(c).isFile()) {
+                    return fs.realpathSync(c);
+                }
+            } catch (_) {
+                // 存在しない候補は無視
+            }
+        }
+        return null;
+    };
+
+    /**
+     * lines を処理し、include 位置に置く行を返す。分割した impl 部分は tails に積む。
+     * inCond: この lines 全体が条件ブロック(#if 系)の中にあるか
+     */
+    const expand = (
+        lines: string[],
+        filePath: string,
+        inCond: boolean,
+    ): string[] => {
+        const out: string[] = [];
+        const dir = path.dirname(filePath);
+        let depth = 0;
+        for (const line of lines) {
+            if (PRAGMA_ONCE_RE.test(line)) {
+                continue;
+            }
+            if (IF_RE.test(line)) depth++;
+            else if (ENDIF_RE.test(line)) depth = Math.max(0, depth - 1);
+
+            const m = line.match(INCLUDE_RE);
+            if (!m) {
+                out.push(line);
+                continue;
+            }
+            const resolved = resolve(m[1], dir);
+            if (resolved === null) {
+                unresolved.push(m[1]);
+                out.push(line);
+                continue;
+            }
+            if (visited.has(resolved) || stack.has(resolved)) {
+                continue;
+            }
+            const conditional = inCond || depth > 0;
+            if (!conditional) {
+                visited.add(resolved);
+            }
+            if (!expandedFiles.includes(resolved)) {
+                expandedFiles.push(resolved);
+            }
+
+            const fileLines = stripIncludeGuard(
+                fs.readFileSync(resolved, 'utf8').split(/\r?\n/),
+            );
+            let markerIdx = conditional
+                ? -1
+                : fileLines.findIndex((l) => markerRe.test(l));
+            if (markerIdx !== -1) {
+                // 目印が #if 系ブロックの中にあると分割で壊れるので分割しない
+                let d = 0;
+                for (let x = 0; x < markerIdx; x++) {
+                    if (IF_RE.test(fileLines[x])) d++;
+                    else if (ENDIF_RE.test(fileLines[x]))
+                        d = Math.max(0, d - 1);
+                }
+                if (d > 0) {
+                    warnings.push(
+                        `${m[1]}: ${implMarker} が #if/#ifdef ブロックの中にあるため、分割せずに展開しました`,
+                    );
+                    markerIdx = -1;
+                }
+            }
+            const head =
+                markerIdx === -1 ? fileLines : fileLines.slice(0, markerIdx);
+            const impl = markerIdx === -1 ? [] : fileLines.slice(markerIdx + 1);
+
+            stack.add(resolved);
+            out.push(`// ===== begin: ${m[1]} =====`);
+            out.push(...expand(head, resolved, conditional));
+            out.push(`// ===== end: ${m[1]} =====`);
+            if (impl.length > 0) {
+                const implOut = expand(impl, resolved, false);
+                tails.push(
+                    [`// ===== impl: ${m[1]} =====`, ...implOut]
+                        .join('\n')
+                        .replace(/\s+$/, ''),
+                );
+            }
+            stack.delete(resolved);
+        }
+        return out;
+    };
+
+    let rootReal = rootPath;
+    try {
+        rootReal = fs.realpathSync(rootPath);
+    } catch (_) {
+        // 未保存などで実体がない場合はそのまま
+    }
+    visited.add(rootReal);
+    stack.add(rootReal);
+    let code = expand(rootText.split(/\r?\n/), rootReal, false).join('\n');
+    if (tails.length > 0) {
+        code = code.replace(/\s*$/, '\n') + '\n' + tails.join('\n\n') + '\n';
+    }
+    return {
+        code,
+        expandedFiles,
+        unresolved: [...new Set(unresolved)],
+        warnings,
+    };
+};
