@@ -0,0 +1,90 @@
+/**
+ * [fork] Competitive Companion から受け取った問題の保存先パスを決める
+ * (vscode に依存しない純粋なモジュール)
+ */
+import os from 'os';
+import path from 'path';
+
+/** ファイル名・フォルダ名に使えない文字を _ に置き換える */
+export const sanitizeSegment = (s: string): string =>
+    // eslint-disable-next-line no-control-regex
+    s.replace(/[\\/:*?"<>|\x00-\x1f]+/g, '_').trim();
+
+export const getProblemPathVars = (
+    url: string,
+    group: string | undefined,
+    workspaceFolder: string,
+): Record<string, string> => {
+    let contest = '';
+    let task = '';
+    let index = '';
+    // 例: https://atcoder.jp/contests/abc400/tasks/abc400_a
+    const m = url.match(/\/contests\/([^/?#]+)\/tasks\/([^/?#]+)/);
+    if (m) {
+        contest = m[1];
+        task = m[2];
+        index = task.includes('_')
+            ? task.slice(task.lastIndexOf('_') + 1)
+            : task;
+    }
+    return {
+        workspaceFolder,
+        contest: sanitizeSegment(contest),
+        task: sanitizeSegment(task),
+        index: sanitizeSegment(index),
+        group: sanitizeSegment(group ?? ''),
+    };
+};
+
+/** `${name}` を置換する。未知の変数名は unknown に入れ、空文字にする */
+export const applyPathVars = (
+    template: string,
+    vars: Record<string, string>,
+): { value: string; unknown: string[] } => {
+    const unknown: string[] = [];
+    const value = template.replace(/\$\{(\w+)\}/g, (_all, key: string) => {
+        if (key in vars) return vars[key];
+        unknown.push(key);
+        return '';
+    });
+    return { value, unknown };
+};
+
+export type ProblemPathResult = {
+    dir: string;
+    /** 拡張子なしのファイル名。null なら cph 標準の名前を使う */
+    baseName: string | null;
+    unknown: string[];
+};
+
+export const resolveProblemPath = (
+    dirTemplate: string,
+    fileNameTemplate: string,
+    vars: Record<string, string>,
+): ProblemPathResult => {
+    const workspaceFolder = vars.workspaceFolder;
+    const unknown: string[] = [];
+
+    let dir = workspaceFolder;
+    if (dirTemplate.trim() !== '') {
+        const r = applyPathVars(dirTemplate.trim(), vars);
+        unknown.push(...r.unknown);
+        let d = r.value;
+        if (d === '~') {
+            d = os.homedir();
+        } else if (d.startsWith('~/')) {
+            d = path.join(os.homedir(), d.slice(2));
+        }
+        dir = path.resolve(workspaceFolder, d);
+    }
+
+    let baseName: string | null = null;
+    if (fileNameTemplate.trim() !== '') {
+        const r = applyPathVars(fileNameTemplate.trim(), vars);
+        unknown.push(...r.unknown);
+        const b = sanitizeSegment(r.value);
+        // 変数が空になった(AtCoder 以外の URL など)ときは標準の名前に戻す
+        baseName = b === '' || /^[._]+$/.test(b) ? null : b;
+    }
+    return { dir, baseName, unknown: [...new Set(unknown)] };
+};
